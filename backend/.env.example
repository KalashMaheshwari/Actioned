# Actioned Environment Variables

# Anthropic Claude API Key for extraction & conflict verification
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SQLite Database Path
DATABASE_PATH=actioned.db

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./chroma_db

# Integrations (Optional / Person B)
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
SLACK_WEBHOOK_URL=

# App settings
PORT=8000
HOST=0.0.0.0
